# Derive semantic-only serving from the attested immutable study worker image.
ARG STUDY_WORKER
FROM ${STUDY_WORKER}
ARG STUDY_WORKER
RUN python -c "import re,sys; assert re.fullmatch(r'sha256:[0-9a-f]{64}',sys.argv[1])" "${STUDY_WORKER}" \
    && cp -a /study /workspace \
    && groupadd --system --gid 10001 privoke \
    && useradd --system --uid 10001 --gid privoke --no-create-home privoke \
    && mkdir -p /var/lib/privoke \
    && chown privoke:privoke /var/lib/privoke
ENV PYTHONPATH=/workspace/evaluation:/workspace/shared/python:/workspace/extension/client-runtime:/workspace/extension/client-runtime/generated
ENV HOME=/tmp PYTHONUNBUFFERED=1 PRIVOKE_GRPC_HOST=0.0.0.0
ENV TELEMETRY_PRIVACY_LEDGER_PATH=/var/lib/privoke/telemetry-budget.sqlite3
WORKDIR /workspace/extension/client-runtime
USER privoke:privoke
EXPOSE 50054
# The isolated Compose contract supplies the direct semantic gRPC entrypoint.
