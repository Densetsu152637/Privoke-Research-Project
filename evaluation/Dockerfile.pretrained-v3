FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false CUBLAS_WORKSPACE_CONFIG=:4096:8 V3_BIND=0.0.0.0
COPY evaluation/requirements-pretrained-v3-server.txt /app/evaluation/requirements-pretrained-v3-server.txt
RUN python -m pip install --no-cache-dir torch==2.11.0+cu128 --index-url https://download.pytorch.org/whl/cu128 && python -m pip install --no-cache-dir -r evaluation/requirements-pretrained-v3-server.txt && python -m pip check
COPY shared/python /app/shared/python
COPY shared/proto /app/shared/proto
COPY extension/client-runtime/src /app/extension/client-runtime/src
COPY services/privoke-fuzzer/src /app/services/privoke-fuzzer/src
COPY services/privoke-fuzzer/data /app/services/privoke-fuzzer/data
COPY services/pretrained-v3/src /app/services/pretrained-v3/src
RUN mkdir -p extension/client-runtime/generated && python -m grpc_tools.protoc -I shared/proto --python_out=extension/client-runtime/generated --grpc_python_out=extension/client-runtime/generated shared/proto/privoke/v1/runtime.proto shared/proto/privoke/v1/parameters.proto shared/proto/privoke/experimental/v3.proto
CMD ["python", "services/pretrained-v3/src/runtime_server.py"]
