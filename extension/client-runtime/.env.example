# Loaded before runtime configuration. Existing process environment takes precedence.
# For an installed package: PRIVOKE_ENV_FILE=/absolute/path/to/private/runtime.env
# Public cloud endpoint, without https://. Must match the server certificate DNS name.
PRIVOKE_CLOUD_TARGET=your-stack.example.com:443
# Hidden developer setting; the extension's saved toggle overrides this when managed.
PRIVOKE_USE_LOCAL_STACK=false
# Local development targets used when the popup is switched to Dev.
PRIVOKE_LOCAL_MODEL_STREAMING_TARGET=127.0.0.1:50051
PRIVOKE_LOCAL_TELEMETRY_TARGET=127.0.0.1:50055

# Each installation gets its own client certificate and private key.
# Paths are relative to this .env file. Never bundle an operator/deployment key.
PRIVOKE_TLS_CERT_FILE=secrets/client.crt
PRIVOKE_TLS_KEY_FILE=secrets/client.key
# Blank uses the system's trusted roots. Set for a private server CA.
PRIVOKE_TLS_CA_FILE=

PRIVOKE_LLM_CHOICE=streamed
# Standard V3 balanced; explicit privoke-v3-{efficient,balanced,quality} or older V1 IDs.
MODEL_ID=latest
PRIVOKE_MODEL_DEVICE=cpu
# Optional private cache override; default is the per-user workstation cache.
# MODEL_PACKAGE_CACHE_DIR=/path/to/private/model-packages
MODEL_PACKAGE_TIMEOUT_SECONDS=120
MODEL_STREAMING_CONSUMER_ID=client-runtime
MODEL_STREAMING_TIMEOUT_SECONDS=10
# Experimental full_projected_adam64_v1 only: set BOTH before process startup.
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
TELEMETRY_ENABLED=false
TELEMETRY_LDP_EPSILON=1
TELEMETRY_LDP_DAILY_EPSILON=8
# On native installs the default is a stable per-user state path. Set this only
# when that default is not writable or persistent.
# TELEMETRY_PRIVACY_LEDGER_PATH=/path/to/privoke/telemetry-budget.sqlite3

# Optional credentials owned by this installation, only for these classifier backends.
OPENAI_API_KEY=
LM_STUDIO_API_KEY=
# Optional prepared TRAIN-window policy; configure accepted hashes independently.
# PRIVOKE_WINDOW_PATH=/training-window/window.json
# PRIVOKE_WINDOW_MANIFEST_SHA256=<accepted-window-sha256>
# PRIVOKE_COMPONENT_BANK_PATH=/training-window/bank.json
# PRIVOKE_COMPONENT_REFERENCE_PATH=/training-window/references-v2.json
# PRIVOKE_COMPONENT_MANIFEST_PATH=/training-window/component-manifest-v2.json
# PRIVOKE_COMPONENT_MANIFEST_SHA256=<accepted-component-manifest-sha256>
# PRIVOKE_COMPONENT_TEACHER_PATH=/training-window/original.json
# PRIVOKE_COMPONENT_TEACHER_SHA256=<independently-accepted-original-file-sha256>
