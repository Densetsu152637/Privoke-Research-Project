# Copy to /opt/privoke/.env on the VM; used by deploy.sh and privoke-pki-sync, never baked into an image.
GCP_PROJECT_ID=your-project-id
# The public DNS name of the stack. It must be in the server certificate; loopback smoke tests address it by this name.
STACK_HOST=stack.example.com
# Secret Manager secret IDs, each containing one PEM file. Create them as in docs/deployment/google-cloud.md, section 4.
TLS_CERT_SECRET=privoke-server-cert
TLS_KEY_SECRET=privoke-server-key
CLIENT_CA_SECRET=privoke-client-ca
SERVER_CA_SECRET=privoke-server-ca
# The revocation list and the registry. The VM refreshes both from these every six hours; the operator publishes a new CRL
# at least every 5 days (it lapses after 7, and every server then refuses every handshake).
CRL_SECRET=privoke-crl
REGISTRY_SECRET=privoke-registry
# Service identities: <prefix>-<name>-cert and <prefix>-<name>-key for probe, param-update, v3-fuzzer and v3-runtime. Registry
# roles: probe runtime, param-update publisher (it is also the scheduler), v3-fuzzer trainer, v3-runtime runtime. The server
# certificate must also name v3-fuzzer and v3-runtime.
SERVICE_SECRET_PREFIX=privoke-svc
# Smoke-test identities: <prefix>-installation-{cert,key} (a registered installation used only for smoke tests) and
# <prefix>-reporter-{cert,key}. Optional extra negative checks: <prefix>-unregistered-{cert,key} (signed by the client CA,
# not in the registry) and <prefix>-foreign-{cert,key} (signed by another CA).
SMOKE_SECRET_PREFIX=privoke-smoke
# Stage verified packages separately; weights are not included in release images.
MODEL_RELEASE_DIR=/opt/privoke/model-releases
MODEL_LATEST_ID=privoke-v3-balanced
# Minutes a switched release may stay unconfirmed before it is rolled back automatically.
PENDING_TIMEOUT_MINUTES=30
# V3 routine training (stage V3-R7: the update service with the checkpoint store and the scheduler, the V3 fuzzer and the V3
# runtime) needs the explicit profile v3-training. V1 training is retired. Leave COMPOSE_PROFILES empty to run only the model and
# telemetry services. The V1 MODEL_ID and FUZZER_TARGET settings no longer exist.
COMPOSE_PROFILES=
# The scheduler: count 0 switches it off; interval 0 requests one round (three tiers by HEADS then FULL_ENCODER) and stops. A full
# round takes about 30 to 45 minutes on 8 CPUs (quality FULL_ENCODER fit about 25 minutes), so keep the interval above that.
FUZZER_PROMPT_COUNT=32
FUZZER_REQUEST_INTERVAL_SECONDS=10800
FUZZER_REQUEST_SEED=1337
# Inputs of the v3-training profile, staged by the operator and mounted read-only. None is part of an image or a repository.
#   V3_ORIGINAL_DIR   one directory per tier (efficient, balanced, quality): the independently prepared ORIGINAL packages
#                     (manifest.json, model.safetensors, config.json, vocab.txt) that the pinned standard releases descend from
#   V3_INPUTS_DIR     the pinned BC01 inputs in their repository layout (evaluation/results/iterative_fuzzer_20261011/...); the
#                     tracked Python closure and the bundled audience data are added per release from the deployed commit
#   V3_RETENTION_BANK_DIR  a directory holding approved-train-bank.json (prompt text; checked against its compiled pin)
V3_ORIGINAL_DIR=/opt/privoke/v3-originals
V3_INPUTS_DIR=/opt/privoke/v3-inputs
V3_RETENTION_BANK_DIR=/opt/privoke/v3-retention-bank
# The Secret Manager secret holding the Ed25519 publication seed (64 hexadecimal characters), and the id clients know its public
# half by (compiled into the client as PRODUCTION_KEYS; see docs/runtime/v3-publication.md, Key custody). Never an image layer.
V3_PUBLICATION_KEY_SECRET=privoke-v3-publication-key
V3_PUBLICATION_KEY_ID=privoke-v3-pub-2026-11
# Optional: which tiers a round trains, and the runtime's thread count (the VM's CPUs).
# V3_TIERS=efficient,balanced,quality
# V3_TORCH_THREADS=8
