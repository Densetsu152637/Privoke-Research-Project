# Copy to /opt/privoke/.env on the VM; used by deploy.sh, never baked into an image.
GCP_PROJECT_ID=your-project-id
# Secret Manager secret IDs, each containing a PEM file.
TLS_CERT_SECRET=privoke-server-cert
TLS_KEY_SECRET=privoke-server-key
CLIENT_CA_SECRET=privoke-client-ca
# Stage verified packages separately; weights are not included in release images.
MODEL_RELEASE_DIR=/opt/privoke/model-releases
MODEL_LATEST_ID=privoke-v3-balanced
# Legacy V1 training requires the explicit legacy-training Compose profile.
# Within that profile, count 0 disables requests; interval 0 requests one cycle.
FUZZER_PROMPT_COUNT=32
FUZZER_REQUEST_INTERVAL_SECONDS=3600
FUZZER_REQUEST_SEED=1337
