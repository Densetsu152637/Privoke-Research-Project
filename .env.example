# GitHub Actions: create ALL of these as secrets in the production environment.
# Identifiers are stored as secrets for one consistent setup; no static token/key is needed.
# GitHub supplies GITHUB_TOKEN and the OIDC token automatically. Do not create either.
GCP_PROJECT_ID=your-project-id
GCP_REGION=australia-southeast1
GCP_ARTIFACT_REPOSITORY=privoke
GCP_INSTANCE=privoke-stack
GCP_ZONE=australia-southeast1-b
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/github/providers/github
GCP_DEPLOY_SERVICE_ACCOUNT=github-deployer@your-project-id.iam.gserviceaccount.com

# Optional LOCAL Compose settings. GitHub does not read this file automatically.
FUZZER_PROMPT_COUNT=0
PRIVOKE_MODEL_DEVICE=cpu
# Workstation credentials belong in extension/client-runtime/.env instead.
# VM certificate secret names belong in deploy/gce/.env (see its example).
